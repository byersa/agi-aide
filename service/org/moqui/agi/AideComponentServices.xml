<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="classify" noun="AppIntent" type="script"
             location="component://agi-aide/script/classifyAppIntent.js"
             authenticate="anonymous-all" read-only="true">
        <description>
            Fast micro-classifier for component and screen elicitation. Analyzes narrative text
            using sub-millisecond keyword scoring with an optional AI proxy fast-path, mapping
            to both AGI domain archetypes and Dev AIDE screen gallery templates.
        </description>
        <in-parameters>
            <parameter name="narrative" type="String" required="true"/>
            <parameter name="useAi" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="suggestedArchetype" type="String"/>
            <parameter name="galleryArchetype" type="String"/>
            <parameter name="confidence" type="BigDecimal"/>
        </out-parameters>
    </service>

</services>